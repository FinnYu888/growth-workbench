.tabbar {
  position: fixed; left: 0; right: 0; bottom: 0;
  display: flex; height: 96rpx; padding-bottom: env(safe-area-inset-bottom);
  background: #fff; box-shadow: 0 -4rpx 16rpx rgba(20,184,166,0.08);
  z-index: 100;
}
.tab {
  flex: 1; display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; color: #9ca3af; transition: color .2s;
}
.tab.on { color: #14b8a6; font-weight: 600; }
