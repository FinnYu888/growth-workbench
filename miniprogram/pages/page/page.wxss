/* ============ 通用页样式（配合各 section 类型） ============ */
/* 统计卡网格 */
.stats-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.stat-cell {
  flex: 1 1 calc(50% - 20rpx); min-width: calc(50% - 20rpx);
  border-radius: 20rpx; padding: 26rpx; box-sizing: border-box;
}
.stat-icon { font-size: 40rpx; }
.stat-val { font-size: 44rpx; font-weight: 700; color: #1f2937; margin: 8rpx 0 4rpx; }
.stat-unit { font-size: 26rpx; font-weight: 400; margin-left: 4rpx; }
.stat-label { font-size: 26rpx; color: #374151; }
.stat-sub { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }

/* 今日任务 */
.task-card .task-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.task-title { font-size: 30rpx; font-weight: 600; color: #1f2937; flex: 1; }
.task-tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 999rpx; }
.task-desc { font-size: 26rpx; color: #6b7280; margin-bottom: 20rpx; line-height: 1.6; }
.task-reward { font-size: 24rpx; color: #f59e0b; margin-bottom: 16rpx; }
.task-card .btn { margin-top: 8rpx; }

/* banner */
.banner {
  display: flex; align-items: flex-start; background: linear-gradient(135deg,#e6f7f1,#d3f3ea);
  border-radius: 20rpx; padding: 24rpx; margin-bottom: 24rpx;
}
.banner-ic { font-size: 44rpx; margin-right: 16rpx; }
.banner-title { font-size: 28rpx; font-weight: 600; color: #0f766e; }
.banner-desc { font-size: 24rpx; color: #4b5563; margin-top: 6rpx; line-height: 1.6; }

/* 柱状图 */
.chart-bars { display: flex; align-items: flex-end; height: 300rpx; gap: 10rpx; margin-top: 16rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
.bar { width: 36rpx; border-radius: 8rpx 8rpx 0 0; min-height: 8rpx; transition: height .3s; }
.bar-v { font-size: 18rpx; color: #6b7280; margin-top: 4rpx; }
.bar-l { font-size: 18rpx; color: #9ca3af; margin-top: 2rpx; }
.chart-bars.dual .bar-col { justify-content: flex-end; }
.dual-bars { display: flex; align-items: flex-end; gap: 6rpx; height: 100%; }
.dual-bars .bar { width: 20rpx; }
.dual-legend { display: flex; gap: 24rpx; margin: 8rpx 0; }
.lg { display: flex; align-items: center; font-size: 22rpx; color: #6b7280; }
.lg-dot { width: 16rpx; height: 16rpx; border-radius: 4rpx; margin-right: 8rpx; }

/* 环形图 */
.donut-wrap { display: flex; justify-content: center; margin: 16rpx 0; }
.donut { width: 240rpx; height: 240rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; }
.donut-center {
  width: 150rpx; height: 150rpx; border-radius: 50%; background: #fff;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
}
.donut-c-v { font-size: 38rpx; font-weight: 700; color: #1f2937; }
.donut-c-l { font-size: 20rpx; color: #9ca3af; }
.donut-legend { display: flex; flex-wrap: wrap; gap: 16rpx 28rpx; margin-top: 12rpx; }

/* 列表 */
.list-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f4f3; }
.list-item:last-child { border-bottom: none; }
.list-ic { width: 64rpx; height: 64rpx; border-radius: 16rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-right: 20rpx; flex-shrink: 0; }
.list-body { flex: 1; min-width: 0; }
.list-title { font-size: 28rpx; color: #1f2937; }
.list-done { color: #14b8a6; }
.list-meta { font-size: 24rpx; color: #9ca3af; margin-top: 4rpx; }
.list-right { font-size: 24rpx; color: #6b7280; flex-shrink: 0; }
.list-right.kcal { color: #f43f5e; font-weight: 600; }

/* 行动清单 */
.action-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f4f3; }
.action-item:last-child { border-bottom: none; }
.check {
  width: 40rpx; height: 40rpx; border-radius: 50%; border: 2rpx solid #c6c6c6;
  margin-right: 20rpx; display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #fff; flex-shrink: 0;
}
.check.on { background: #14b8a6; border-color: #14b8a6; }
.action-t { font-size: 28rpx; color: #1f2937; }
.action-t.done { color: #9ca3af; text-decoration: line-through; }
.action-meta { font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }

/* 喝水环 */
.water-ring { width: 240rpx; height: 240rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 16rpx auto; }
.water-center { width: 150rpx; height: 150rpx; border-radius: 50%; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.water-v { font-size: 38rpx; font-weight: 700; color: #0891b2; }
.water-l { font-size: 20rpx; color: #9ca3af; }
.water-note { text-align: center; font-size: 24rpx; color: #6b7280; }

/* 食谱卡 */
.recipe-card { color: #1f2937; }
.recipe-emoji { font-size: 64rpx; }
.recipe-title { font-size: 34rpx; font-weight: 700; margin: 8rpx 0; }
.recipe-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-bottom: 12rpx; }
.recipe-tag { font-size: 22rpx; background: rgba(255,255,255,0.6); padding: 4rpx 16rpx; border-radius: 999rpx; }
.recipe-kcal { font-size: 26rpx; color: #f43f5e; font-weight: 600; margin-bottom: 8rpx; }
.recipe-desc { font-size: 24rpx; color: #4b5563; line-height: 1.6; }

/* 视频卡 */
.vcard { color: #1f2937; }
.vc-emoji { font-size: 72rpx; }
.vc-title { font-size: 34rpx; font-weight: 700; margin: 8rpx 0; }
.vc-desc { font-size: 24rpx; color: #4b5563; margin-bottom: 12rpx; }
.vc-tags { display: flex; gap: 12rpx; margin-bottom: 12rpx; }
.vc-tag { font-size: 22rpx; background: rgba(255,255,255,0.6); padding: 4rpx 16rpx; border-radius: 999rpx; }
.vc-meta { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.vc-meta-i { font-size: 22rpx; color: #4b5563; }
.vc-btn { background: #14b8a6; color: #fff; }

/* 4格统计 */
.stat4-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.stat4-cell { flex: 1 1 calc(50% - 16rpx); min-width: calc(50% - 16rpx); background: #f8fbfa; border-radius: 16rpx; padding: 22rpx; }
.stat4-ic { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin-bottom: 10rpx; }
.stat4-v { font-size: 40rpx; font-weight: 700; color: #1f2937; }
.stat4-u { font-size: 22rpx; font-weight: 400; }
.stat4-l { font-size: 24rpx; color: #6b7280; }
.stat4-d { font-size: 20rpx; color: #9ca3af; }

/* 塔罗翻牌 */
.tarot-tabs { display: flex; gap: 12rpx; margin: 12rpx 0 20rpx; }
.tarot-tab { font-size: 22rpx; padding: 8rpx 20rpx; background: #f0fdfa; color: #0f766e; border-radius: 999rpx; }
.tarot-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.tarot-card { width: calc(33.33% - 12rpx); perspective: 600rpx; }
.tarot-face { position: relative; height: 280rpx; transform-style: preserve-3d; transition: transform .5s; }
.tarot-face.flipped { transform: rotateY(180deg); }
.tarot-back, .tarot-front {
  position: absolute; inset: 0; backface-visibility: hidden;
  border-radius: 20rpx; display: flex; flex-direction: column; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #6366f1, #a78bfa); color: #fff;
}
.tarot-front { transform: rotateY(180deg); background: linear-gradient(135deg, #fff, #f5fbf8); color: #1f2937; box-shadow: 0 4rpx 16rpx rgba(20,184,166,0.15); }
.tarot-back-emoji { font-size: 56rpx; }
.tarot-back-t { font-size: 20rpx; margin-top: 8rpx; }
.tarot-num { font-size: 24rpx; color: #a78bfa; }
.tarot-emoji { font-size: 64rpx; margin: 8rpx 0; }
.tarot-name { font-size: 24rpx; font-weight: 600; }

/* 牌意 */
.cm-head { display: flex; align-items: center; margin-bottom: 16rpx; }
.cm-emoji { font-size: 40rpx; color: #a78bfa; margin-right: 16rpx; }
.cm-name { font-size: 32rpx; font-weight: 700; }
.cm-tags { display: flex; gap: 10rpx; margin-top: 6rpx; }
.cm-tag { font-size: 20rpx; background: #f3edff; color: #6366f1; padding: 4rpx 14rpx; border-radius: 999rpx; }
.cm-text { font-size: 26rpx; color: #4b5563; line-height: 1.7; }

/* 快速概览 */
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-cell { flex: 1 1 calc(33.33% - 16rpx); min-width: calc(33.33% - 16rpx); text-align: center; padding: 16rpx; }
.quick-ic { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin: 0 auto 8rpx; }
.quick-v { font-size: 36rpx; font-weight: 700; color: #1f2937; }
.quick-l { font-size: 22rpx; color: #6b7280; }
.quick-d { font-size: 18rpx; color: #9ca3af; margin-bottom: 10rpx; }
.quick-bar { height: 8rpx; background: #e6f7f1; border-radius: 999rpx; overflow: hidden; }
.quick-bar-fill { height: 100%; border-radius: 999rpx; }

/* 熟练度 */
.mastery-row { display: flex; align-items: center; padding: 14rpx 0; }
.mastery-ic { font-size: 28rpx; margin-right: 12rpx; }
.mastery-name { width: 140rpx; font-size: 24rpx; color: #374151; }
.mastery-bar { flex: 1; height: 14rpx; background: #e6f7f1; border-radius: 999rpx; overflow: hidden; margin: 0 16rpx; }
.mastery-fill { height: 100%; border-radius: 999rpx; }
.mastery-pct { width: 70rpx; text-align: right; font-size: 24rpx; color: #14b8a6; font-weight: 600; }

/* 大进度环 */
.bigring { width: 280rpx; height: 280rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 16rpx auto; }
.bigring-center { width: 200rpx; height: 200rpx; border-radius: 50%; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.bigring-pct { font-size: 56rpx; font-weight: 700; color: #14b8a6; }
.bigring-l { font-size: 22rpx; color: #9ca3af; }

/* 成长记录 */
.journal-date { font-size: 24rpx; color: #9ca3af; margin-bottom: 8rpx; }
.journal-text { font-size: 26rpx; color: #374151; line-height: 1.7; }
.journal-photos { display: flex; gap: 12rpx; margin-top: 12rpx; }
.jp { font-size: 44rpx; }

/* 时间安排 */
.sched-item { display: flex; align-items: center; padding: 18rpx 0; border-bottom: 1rpx solid #f0f4f3; }
.sched-item:last-child { border-bottom: none; }
.sched-time { width: 90rpx; font-size: 22rpx; color: #6b7280; flex-shrink: 0; }
.sched-ic { width: 56rpx; height: 56rpx; border-radius: 14rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; margin: 0 16rpx 0 8rpx; flex-shrink: 0; }
.sched-body { flex: 1; min-width: 0; }
.sched-title { font-size: 26rpx; color: #1f2937; }
.sched-meta { font-size: 20rpx; color: #9ca3af; }
.sched-right { font-size: 22rpx; color: #6b7280; flex-shrink: 0; }

/* 网格/日历占位 */
.grid-tip { font-size: 24rpx; color: #9ca3af; text-align: center; padding: 16rpx 0; }
.cal-strip { display: flex; flex-wrap: wrap; gap: 10rpx; }
.cal-day { width: 56rpx; height: 56rpx; border-radius: 12rpx; display: flex; align-items: center; justify-content: center; font-size: 22rpx; color: #4b5563; }
