.hero { text-align: center; padding: 24rpx 0 32rpx; }
.hero-title { font-size: 46rpx; font-weight: 700; color: #1f2937; }
.hero-sub { font-size: 24rpx; color: #6b7280; margin-top: 10rpx; }

/* 统计卡网格 */
.stats-grid { display: flex; flex-wrap: wrap; gap: 20rpx; margin-bottom: 24rpx; }
.stat-cell {
  flex: 1 1 calc(50% - 20rpx); min-width: calc(50% - 20rpx);
  border-radius: 20rpx; padding: 26rpx; box-sizing: border-box;
}
.stat-icon { font-size: 40rpx; }
.stat-val { font-size: 44rpx; font-weight: 700; color: #1f2937; margin: 8rpx 0 4rpx; }
.stat-unit { font-size: 26rpx; font-weight: 400; margin-left: 4rpx; }
.stat-label { font-size: 26rpx; color: #374151; }
.stat-sub { font-size: 22rpx; color: #6b7280; margin-top: 6rpx; }

/* 模块入口网格 */
.module-grid { display: flex; flex-wrap: wrap; margin-top: 16rpx; }
.module-cell {
  flex: 0 0 25%; display: flex; flex-direction: column; align-items: center;
  padding: 20rpx 0;
}
.module-ic {
  width: 88rpx; height: 88rpx; border-radius: 24rpx;
  display: flex; align-items: center; justify-content: center; font-size: 40rpx;
}
.module-name { font-size: 24rpx; color: #374151; margin-top: 12rpx; }
