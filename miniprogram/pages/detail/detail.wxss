.detail-hero { text-align: center; padding: 36rpx; }
.dh-icon { font-size: 56rpx; }
.dh-val { font-size: 64rpx; font-weight: 700; color: #1f2937; margin: 8rpx 0; }
.dh-unit { font-size: 32rpx; font-weight: 400; margin-left: 6rpx; }
.dh-label { font-size: 30rpx; color: #374151; }
.dh-sub { font-size: 24rpx; color: #6b7280; margin-top: 8rpx; }

.chart-bars { display: flex; align-items: flex-end; height: 300rpx; gap: 10rpx; margin-top: 16rpx; }
.bar-col { flex: 1; display: flex; flex-direction: column; align-items: center; height: 100%; justify-content: flex-end; }
.bar { width: 36rpx; border-radius: 8rpx 8rpx 0 0; min-height: 8rpx; }
.bar-v { font-size: 18rpx; color: #6b7280; margin-top: 4rpx; }
.bar-l { font-size: 18rpx; color: #9ca3af; }

.detail-rows { margin-top: 12rpx; }
.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f4f3; }
.detail-row:last-child { border-bottom: none; }
.dr-label { font-size: 26rpx; color: #374151; flex: 1; }
.dr-value { font-size: 26rpx; color: #6b7280; text-align: right; flex-shrink: 0; max-width: 60%; }

.extra-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 12rpx; }
.extra-cell { flex: 1 1 calc(33.33% - 16rpx); min-width: calc(33.33% - 16rpx); background: #f8fbfa; border-radius: 16rpx; padding: 20rpx; text-align: center; }
.extra-dot { width: 24rpx; height: 24rpx; border-radius: 50%; margin: 0 auto 8rpx; }
.extra-name { font-size: 22rpx; color: #6b7280; }
.extra-v { font-size: 30rpx; font-weight: 700; color: #1f2937; }

.tarot-detail-item { padding: 20rpx 0; border-bottom: 1rpx solid #f0f4f3; }
.tarot-detail-item:last-child { border-bottom: none; }
.td-head { display: flex; align-items: center; gap: 12rpx; }
.td-num { font-size: 22rpx; color: #a78bfa; }
.td-emoji { font-size: 32rpx; }
.td-name { font-size: 28rpx; font-weight: 600; color: #1f2937; }
.td-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin: 8rpx 0; }
.td-tag { font-size: 20rpx; background: #f3edff; color: #6366f1; padding: 4rpx 14rpx; border-radius: 999rpx; }
.td-meaning { font-size: 24rpx; color: #4b5563; line-height: 1.6; }
