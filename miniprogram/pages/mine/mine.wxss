.user-card {
  display: flex; align-items: center; background: linear-gradient(135deg, #14b8a6, #5eead4);
  border-radius: 28rpx; padding: 36rpx; margin-bottom: 24rpx; color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(20,184,166,0.25);
}
.user-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%; background: rgba(255,255,255,0.25);
  display: flex; align-items: center; justify-content: center; font-size: 56rpx; margin-right: 28rpx;
}
.user-meta { flex: 1; }
.user-name { font-size: 38rpx; font-weight: 700; }
.user-tag { display: inline-block; font-size: 22rpx; background: rgba(255,255,255,0.25); padding: 4rpx 16rpx; border-radius: 999rpx; margin: 10rpx 0; }
.user-sig { font-size: 24rpx; opacity: .9; }

.data-row { display: flex; gap: 20rpx; margin-bottom: 24rpx; }
.data-cell {
  flex: 1; background: #fff; border-radius: 20rpx; padding: 28rpx; text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(20,184,166,0.06);
}
.data-v { font-size: 44rpx; font-weight: 700; color: #14b8a6; }
.data-l { font-size: 24rpx; color: #6b7280; margin-top: 6rpx; }

.menu-list { margin-top: 12rpx; }
.menu-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f0f4f3; }
.menu-item:last-child { border-bottom: none; }
.menu-ic { width: 64rpx; height: 64rpx; border-radius: 18rpx; display: flex; align-items: center; justify-content: center; font-size: 32rpx; margin-right: 20rpx; }
.menu-name { flex: 1; font-size: 28rpx; color: #374151; }
.menu-arrow { font-size: 36rpx; color: #cbd5e1; }

.logout-btn {
  margin-top: 40rpx; background: #fff; color: #f43f5e; border-radius: 999rpx;
  font-size: 30rpx; height: 88rpx; line-height: 88rpx; box-shadow: 0 4rpx 16rpx rgba(244,63,94,0.1);
}
.logout-btn::after { border: none; }
